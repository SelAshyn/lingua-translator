
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "selected-text-translator-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "ratelimits": [
  	{
    	"name": "TRANSLATE_LIMITER",
     "namespace_id": "1001",
     "simple": {
      	"limit": 100,
       "period": 60
    }
   }
  ]
}
